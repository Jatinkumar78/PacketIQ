# Environment / secrets — NEVER commit these
.env
*.env
!.env.example

# Python
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
.eggs/
*.egg

# Virtual environments
venv/
.venv/
env/

# IDE / editor
.vscode/
.idea/
*.swp

# OS junk
.DS_Store
Thumbs.db

# Claude Code local settings (machine-specific). The glob also catches the
# "settings.local 2.json" duplicates macOS leaves behind when a sync or a
# concurrent write collides — same machine-specific content, same reason to
# stay out of the repo.
.claude/settings.local*.json
.claude/launch.json

# Test artifacts
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/
.coverage
.coverage.*
.coverage*
coverage.xml

# Reports generated by PacketIQ (ad-hoc reports stay local)
reports/*
report_*.md
# ...but keep the curated results reports the README/docs link to (small, no PCAP
# data — just the numbers/tables). Delete locally if you'd rather not track them.
!reports/detection_real.md
!reports/detection_synthetic.md
!reports/performance.md
!reports/faithfulness_ablation.md
!reports/copilot_faithfulness_comparison.md
!reports/ollama_tuning.md

# PCAP samples (can be large)
samples/*.pcap
samples/*.pcapng

# Sandbox-campaign generated captures (regenerated by docs/sandbox_test/run_campaign.py)
docs/sandbox_test/pcaps/

# Downloaded real-world validation captures (large; malware traffic — never commit)
datasets/real/
datasets/**/*.pcap
datasets/**/*.pcapng
.claude/settings.local*.json
