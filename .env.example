# PacketIQ environment configuration
# Copy this file to .env and fill in your real credentials — never commit .env
#
# IMPORTANT: This is a TEMPLATE. Leave the values empty / as placeholders.
# Put your real keys only in .env (which is gitignored).

# ─────────────────────────────────────────────────────────
# AI COPILOT  (optional — the tool's core analysis runs fully
#             offline; keys are only needed for the AI chat/report)
# The webapp auto-detects whichever provider is available.
# Priority: GEMINI_API_KEY > GROQ_API_KEY > ANTHROPIC_API_KEY > Ollama (local)
# ─────────────────────────────────────────────────────────

# Option 1 — Google Gemini 2.0 Flash (FREE, recommended)
# Sign up at: https://aistudio.google.com  → Get API key
# Note: Google grants free-tier quota per *model* and per *project*, not per key.
# If your project has no allowance for the default model the API replies
# "limit: 0" — PacketIQ then retries the next candidate model automatically, and
# a new key from the same project will not change anything. Set GEMINI_MODEL to
# pin one yourself (e.g. gemini-flash-lite-latest).
GEMINI_API_KEY=
GEMINI_MODEL=

# Option 2 — Groq (FREE, fastest inference)
# Sign up at: https://console.groq.com  → API Keys → Create
# Free limits: 30 req/min on Llama 3.3 70B
GROQ_API_KEY=
GROQ_MODEL=

# Option 3 — Anthropic Claude (PAID — requires credits)
# Sign up at: https://console.anthropic.com → API Keys
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# Option 4 — Local model via Ollama (FREE, fully offline, no key)
# The copilot runs entirely on your machine — nothing leaves it, no rate
# limits. Install Ollama (https://ollama.com), then: ollama pull qwen2.5:7b-instruct
# (llama3.1:8b also works). Auto-detected when the daemon is running; used as a
# fallback when no cloud key is set (or pick "Local (Ollama)" in the web selector).
#   OLLAMA_MODEL            override the model (default: qwen2.5:7b-instruct)
#   OLLAMA_HOST             override the daemon URL (default http://localhost:11434)
#   OLLAMA_SEED             sampling seed (default 42, so the same capture always
#                           produces the same words); set to "random" to opt out
#   PACKETIQ_ENABLE_OLLAMA  set to 0 to disable local-LLM auto-detection
OLLAMA_MODEL=
OLLAMA_SEED=

# Grounding guardrail (anti-hallucination). ON by default: a deterministic filter
# redacts any IP / MITRE technique / CVE / domain / file hash the copilot states
# that isn't in the capture evidence — so even a small local model reaches 0
# hallucinations (verified across qwen2.5:7b, llama3.1:8b, llama3.2:3b).
# Set to 0 ONLY to measure the raw, unfiltered model (e.g. in tools/eval_copilot.py).
#   PACKETIQ_GROUNDING_GUARD   0 disables the guardrail (default: 1 / on)
# Copilot sampling temperature (lower = more evidence-bound). Default 0.15.
#   PACKETIQ_AI_TEMPERATURE    default 0.15

# ─────────────────────────────────────────────────────────
# NVD CVE LOOKUP  (optional but recommended)
# PacketIQ reads real software banners from a capture (HTTP Server /
# User-Agent headers) and queries NIST's official NVD API for matching
# CVEs. A key is free and raises the rate limit from ~5 to ~50 req/30s.
# Request one at: https://nvd.nist.gov/developers/request-an-api-key
# ─────────────────────────────────────────────────────────
NVD_API_KEY=

# ─────────────────────────────────────────────────────────
# TELEGRAM ALERTS  (optional)
# Get a bot token from @BotFather on Telegram
# ─────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
